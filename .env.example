# ================================================================
# TorrentBox — Environment Configuration
# Copy this file to .env and fill in your values
# ================================================================

# --- Flood JWT Secret (CHANGE THIS — use a long random string) ---
FLOOD_SECRET=change_me_to_a_long_random_secret_string_here

# --- Download Storage Path (absolute path on VPS) ---
# Default: ./data/downloads (relative to this project dir)
# Example: /mnt/volume/downloads
DOWNLOADS_PATH=./data/downloads

# --- User/Group ID (run: id -u && id -g on your VPS) ---
UID=1000
GID=1000
