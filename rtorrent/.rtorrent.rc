# ================================================================
# rTorrent Configuration — Optimized for 12GB RAM VPS
# Used by: crazymax/rtorrent-flood image
# Mount: ./rtorrent/.rtorrent.rc → /data/.rtorrent.rc (optional override)
# ================================================================
# NOTE: The crazymax image manages the SCGI socket internally.
# You do NOT need to set network.scgi.open_local here.
# ================================================================

# --- Network Ports ---
network.port_range.set          = 6881-6881
network.port_random.set         = no

# --- File Descriptor Limits (match OS ulimit) ---
network.max_open_files.set      = 65536
network.max_open_sockets.set    = 65536

# --- Bandwidth (0 = unlimited) ---
throttle.global_down.max_rate.set = 0
throttle.global_up.max_rate.set   = 0
throttle.max_uploads.set          = 0

# --- Peer Limits (tuned for 12GB RAM) ---
throttle.max_peers.normal.set   = 200
throttle.min_peers.normal.set   = 50
throttle.max_peers.seed.set     = 100
throttle.min_peers.seed.set     = 25
throttle.max_uploads.global.set = 500

# ================================================================
# Memory — 6144M (6GB) of 12GB for piece cache
# This is the single biggest factor for download speed
# ================================================================
pieces.memory.max.set           = 6144M
pieces.preload.type.set         = 2
pieces.preload.min_size.set     = 262144
pieces.preload.min_rate.set     = 5000

# --- Hashing ---
pieces.hash.on_completion.set   = yes

# --- I/O ---
system.umask.set                = 0022

# --- Directories ---
directory.default.set           = /downloads
session.path.set                = /data/session

# --- Protocol ---
protocol.encryption.set         = allow_incoming,try_outgoing,enable_retry

# --- DHT (dramatically improves peer discovery) ---
dht.mode.set                    = auto
dht.port.set                    = 6881

# --- Peer Exchange ---
protocol.pex.set                = yes

# --- UDP Trackers ---
trackers.use_udp.set            = yes
trackers.delay_scrape.set       = yes

# --- Watch Directory (auto-add .torrent files dropped here) ---
schedule2 = watch_directory,5,5,"load.start=/downloads/watch/*.torrent"
